msgid "New follower"
msgstr "متابع جديد"

msgid "Someone started following your business."
msgstr "بدأ شخص ما بمتابعة نشاطك التجاري."

msgid "New comment"
msgstr "تعليق جديد"

msgid "New message"
msgstr "رسالة جديدة"

msgid "Sent a photo"
msgstr "أرسل صورة"

msgid "Sent a video"
msgstr "أرسل مقطع فيديو"

msgid "Shared a post"
msgstr "شارك منشورًا"

msgid "Shared a reel"
msgstr "شارك ريل"

msgid "Shared a product"
msgstr "شارك منتجًا"

msgid "New like"
msgstr "إعجاب جديد"

msgid "Someone liked your content."
msgstr "أعجب شخص ما بمحتواك."

msgid "New share"
msgstr "مشاركة جديدة"

msgid "Someone shared your content."
msgstr "شارك شخص ما محتواك."

msgid "New rating"
msgstr "تقييم جديد"

msgid "Someone rated your business."
msgstr "قيّم شخص ما نشاطك التجاري."

msgid "Your post was approved"
msgstr "تمت الموافقة على منشورك"

msgid "Your post is now published."
msgstr "تم نشر منشورك."

msgid "Your post was rejected"
msgstr "تم رفض منشورك"

msgid "Your reel was approved"
msgstr "تمت الموافقة على الريل الخاص بك"

msgid "Your reel is now published."
msgstr "تم نشر الريل الخاص بك."

msgid "Your reel was rejected"
msgstr "تم رفض الريل الخاص بك"

msgid "Your story was approved"
msgstr "تمت الموافقة على قصتك"

msgid "Your story is now published."
msgstr "تم نشر قصتك."

msgid "Your story was rejected"
msgstr "تم رفض قصتك"

msgid "Your content was approved"
msgstr "تمت الموافقة على المحتوى الخاص بك"

msgid "Your content is now published."
msgstr "تم نشر المحتوى الخاص بك."

msgid "Your content was rejected"
msgstr "تم رفض المحتوى الخاص بك"

#, python-format
msgid "Reason: %(reason)s"
msgstr "السبب: %(reason)s"

msgid "Your storage is full. Upgrade your plan to upload more."
msgstr "مساحة التخزين ممتلئة. قم بترقية باقتك لرفع المزيد."

msgid "Your free trial ends in 3 days"
msgstr "تنتهي تجربتك المجانية خلال 3 أيام"

msgid "Choose a plan before it ends to keep uploading and keep your content."
msgstr "اختر باقة قبل انتهائها لتواصل الرفع وتحافظ على محتواك."

msgid "Your free trial ends tomorrow"
msgstr "تنتهي تجربتك المجانية غدًا"

msgid "Choose a plan today to keep uploading and keep your content."
msgstr "اختر باقة اليوم لتواصل الرفع وتحافظ على محتواك."

msgid "Your free trial has ended"
msgstr "انتهت تجربتك المجانية"

msgid "Your account is locked. Subscribe within 2 days or your content will be permanently deleted."
msgstr "تم قفل حسابك. اشترك خلال يومين وإلا سيتم حذف محتواك نهائيًا."

msgid "Your content has been deleted"
msgstr "تم حذف محتواك"

msgid "Your content was permanently deleted because no plan was activated. You can subscribe and start again."
msgstr "تم حذف محتواك نهائيًا لعدم تفعيل أي باقة. يمكنك الاشتراك والبدء من جديد."

msgid "Your subscription is active"
msgstr "تم تفعيل اشتراكك"

msgid "Thank you! Your plan is now active."
msgstr "شكرًا لك! باقتك مفعّلة الآن."

msgid "Your subscription ends in 3 days"
msgstr "ينتهي اشتراكك خلال 3 أيام"

msgid "Renew your plan to avoid losing access."
msgstr "جدّد باقتك لتتجنب فقدان الوصول."

msgid "Your subscription ends tomorrow"
msgstr "ينتهي اشتراكك غدًا"

msgid "Renew your plan today to avoid losing access."
msgstr "جدّد باقتك اليوم لتتجنب فقدان الوصول."

msgid "Your subscription has ended"
msgstr "انتهى اشتراكك"

msgid "Your account is locked. Renew within 60 days or your content will be permanently deleted."
msgstr "تم قفل حسابك. جدّد خلال 60 يومًا وإلا سيتم حذف محتواك نهائيًا."
