# Copy this file to .env for local development.
# .env is gitignored — never commit real secrets.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (parsed by django-environ's env.db()) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://scd_user:scd_password@db:5432/scd_dev

# --- Redis (cache, Channels layer, Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated list, empty by default in dev) ---
CORS_ALLOWED_ORIGINS=

# --- JWT (consumed by rest_framework_simplejwt's SIMPLE_JWT settings,
#     wired up in the auth part — this only reserves the env var names) ---
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Sentry (leave empty locally; sentry_sdk.init is skipped if unset) ---
# INPUT REQUIRED — see architecture Section 7. Actual sentry_sdk.init() call
# happens in the monitoring part (P-024), not here.
SENTRY_DSN=

# --- Object storage (media/uploads — provider-agnostic, e.g. S3-compatible) ---
# INPUT REQUIRED — see architecture Section 7. Blank until real credentials
# exist; app falls back to local disk storage in dev without these set.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_REGION=

# --- Firebase Cloud Messaging (push notifications) ---
# INPUT REQUIRED — see architecture Section 7. Blank until a real Firebase
# project exists; push notifications are simply not sent without these.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# --- Paymob (payments) ---
# INPUT REQUIRED — see architecture Section 7. Blank until real Paymob
# credentials exist; this MVP has no in-app payment flow anyway (deals
# happen outside the platform), so this is reserved for future use.
PAYMOB_API_KEY=
PAYMOB_WEBHOOK_SECRET=

# --- Postgres container init vars (used by the `db` service itself) ---
POSTGRES_USER=scd_user
POSTGRES_PASSWORD=scd_password
POSTGRES_DB=scd_dev