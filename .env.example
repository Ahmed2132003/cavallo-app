# Copy this file to .env for local development.
# .env is gitignored — never commit real secrets.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (parsed by django-environ's env.db()) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://scd_user:scd_password@db:5432/scd_dev

# --- Redis (cache, Channels layer, Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated list, empty by default in dev) ---
CORS_ALLOWED_ORIGINS=

# --- JWT (consumed by rest_framework_simplejwt's SIMPLE_JWT settings,
#     wired up in the auth part — this only reserves the env var names) ---
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Sentry (leave empty locally; sentry_sdk.init is skipped if unset) ---
# INPUT REQUIRED - see architecture Section 7. Only staging and prod call
# sentry_sdk.init() (Part P-105); dev never does, even if this is set.
SENTRY_DSN=

# --- Object storage (media/uploads — provider-agnostic, e.g. S3-compatible) ---
# INPUT REQUIRED — see architecture Section 7. Blank until real credentials
# exist; app falls back to local disk storage in dev without these set.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_REGION=

# --- Firebase Cloud Messaging (push notifications) ---
# INPUT REQUIRED — see architecture Section 7. Blank until a real Firebase
# project exists; push notifications are simply not sent without these.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# --- Paymob (payments) ---
# INPUT REQUIRED — see architecture Section 7. Blank until real Paymob
# credentials exist; this MVP has no in-app payment flow anyway (deals
# happen outside the platform), so this is reserved for future use.
PAYMOB_API_KEY=
PAYMOB_WEBHOOK_SECRET=
# Paymob Intention API (Part P-089). Leave blank until real credentials exist;
# PAYMOB_WEBHOOK_SECRET above must be the dashboard HMAC secret (not the API key).
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://eg.checkout.paymob.com/
PAYMOB_NOTIFICATION_URL=
PAYMOB_REDIRECTION_URL=
PAYMENT_GATEWAY=payments.gateways.paymob.PaymobGateway

# --- Email / SMTP (password reset OTP) ---
# EMAIL_USE_REAL_SMTP only affects the dev stack (docker compose):
#   false (default) = emails are printed to the console (the OTP shows in the logs)
#   true            = emails are really sent through the SMTP settings below,
#                     and nothing (OTP, password) is printed to the logs.
# staging/prod always use SMTP. After changing .env run:
#   docker compose up -d --force-recreate web celery_worker
# Check the setup with:
#   docker compose exec web python manage.py send_test_email --to you@example.com
#
# Gmail example (needs 2-Step Verification ON, then create an App Password at
# https://myaccount.google.com/apppasswords):
#   EMAIL_USE_REAL_SMTP=true
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_USE_SSL=false
#   EMAIL_HOST_USER=<your gmail address>
#   EMAIL_HOST_PASSWORD=<16-character App Password, no spaces; NOT your normal password>
#   DEFAULT_FROM_EMAIL=<same as EMAIL_HOST_USER; or leave blank to default to it>
# Logs never print EMAIL_HOST_PASSWORD (send_test_email only says whether it is set).
#
# INPUT REQUIRED for staging/prod. Blank values fall back to the defaults.
# EMAIL_USE_TLS (STARTTLS, port 587) and EMAIL_USE_SSL (implicit SSL, port 465)
# are mutually exclusive: enabling both raises ImproperlyConfigured at startup.
# Accepted true values: 1, true, yes, on (case-insensitive); anything else = false.
# Blank EMAIL_USE_TLS defaults to true unless EMAIL_USE_SSL is true.
EMAIL_USE_REAL_SMTP=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
# Blank = EMAIL_HOST_USER if set, else noreply@localhost.
DEFAULT_FROM_EMAIL=

# --- Password reset throttling (Task P2.5) ---
# DRF rate format "N/period" (second|minute|hour|day). Blank = built-in default
# (the values shown here). Two independent layers per endpoint: per client IP
# and per email (normalized + SHA-256 hashed before it reaches the cache key).
PASSWORD_RESET_REQUEST_IDENTIFIER_RATE=5/hour
PASSWORD_RESET_REQUEST_IP_RATE=20/hour
PASSWORD_RESET_VERIFY_IDENTIFIER_RATE=10/hour
PASSWORD_RESET_VERIFY_IP_RATE=30/hour
PASSWORD_RESET_CONFIRM_IDENTIFIER_RATE=5/hour
PASSWORD_RESET_CONFIRM_IP_RATE=20/hour

# --- Trusted reverse proxies in front of Django (client IP for per-IP throttles) ---
# Number of proxies that append to X-Forwarded-For. 0 = ignore the header and use
# the socket address (right for local dev/test). Blank = the environment default:
# 0 for dev/staging, 1 for prod (a single Nginx). Use 2 if Cloudflare (or another
# proxy) is added in front of Nginx. A wrong value either lets clients forge their
# IP (too low) or blocks every user together behind one shared IP (0 behind a proxy).
# Nginx MUST set X-Forwarded-For with $proxy_add_x_forwarded_for (or $remote_addr).
NUM_PROXIES=0

# --- Postgres container init vars (used by the `db` service itself) ---
POSTGRES_USER=scd_user
POSTGRES_PASSWORD=scd_password
POSTGRES_DB=scd_dev